DATABASE_URL=mysql+asyncmy://skill_finder:change_me@127.0.0.1:3306/skill_finder?charset=utf8mb4
# GITHUB_TOKEN 优先从 backend/.secrets/github_token 文件读取（见 README），
# 也支持通过环境变量 GITHUB_TOKEN 提供。
# GITHUB_TOKEN=github_token_here
ADMIN_KEY=replace_with_a_long_random_value
BUSINESS_TIMEZONE=Asia/Shanghai
COLLECTION_CRON=0 2 * * *
SCHEDULER_ENABLED=false
MIN_STARS=100
CORS_ORIGINS=http://localhost:5173
# 项目简介生成（使用本机 opencode CLI，无需额外 API Key）
# INTRO_ENABLED=true 时，采集任务会为缺少简介的仓库自动生成
INTRO_ENABLED=false
INTRO_MODEL=opencode-go/deepseek-v4-flash
INTRO_BATCH_SIZE=5
INTRO_TIMEOUT_SECONDS=300

# 近 30 天多源研究（调用用户级 ~/.codex/skills/last30days）
LAST30DAYS_ENABLED=true
# 默认会自动发现 skill 与 Python 3.12+；仅在自动发现失败时填写
# LAST30DAYS_SKILL_DIR=C:\Users\YOUR_NAME\.codex\skills\last30days
# LAST30DAYS_PYTHON=C:\path\to\python.exe
# LAST30DAYS_MEMORY_DIR=C:\path\to\last30days-memory
LAST30DAYS_TIMEOUT_SECONDS=600
